<Window x:Class="SerialWorkbench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:SerialWorkbench.Converters"
        mc:Ignorable="d"
        Title="Serial Workbench 串口上位机"
        Width="1380"
        Height="860"
        MinWidth="1200"
        MinHeight="760"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <converters:DataPointsToPointCollectionConverter x:Key="DataPointsToPointCollectionConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="16"
                Margin="0,0,0,12"
                Background="#F3F6FB"
                BorderBrush="#D7DFEA"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="24" FontWeight="Bold" Text="WPF 串口上位机" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="#4B5563"
                               Text="支持灵活串口配置、协议解析、数据可视化、记录与回放。建议使用 Visual Studio 2022 打开解决方案进行二次开发。" />
                </StackPanel>
                <Border Grid.Column="1"
                        Padding="16,10"
                        Background="#E8FFF1"
                        BorderBrush="#7DD3A7"
                        BorderThickness="1"
                        CornerRadius="20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontWeight="SemiBold" Text="状态：" />
                        <TextBlock Text="{Binding ConnectionText}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <GroupBox Header="1. 串口参数配置与连接控制" Margin="0,0,0,12">
                        <Grid Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,8,8,8" VerticalAlignment="Center" Text="端口" />
                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,4" ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SelectedPort}" />
                            <Button Grid.Row="0" Grid.Column="2" Margin="8,4,0,4" Padding="12,6" Command="{Binding RefreshPortsCommand}" Content="扫描" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,8,8" VerticalAlignment="Center" Text="波特率" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4" ItemsSource="{Binding BaudRates}" SelectedItem="{Binding SelectedBaudRate}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,8,8" VerticalAlignment="Center" Text="数据位" />
                            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,4" ItemsSource="{Binding DataBitsOptions}" SelectedItem="{Binding SelectedDataBits}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,8,8,8" VerticalAlignment="Center" Text="停止位" />
                            <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,4" ItemsSource="{Binding StopBitsOptions}" SelectedItem="{Binding SelectedStopBits}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,8,8,8" VerticalAlignment="Center" Text="校验位" />
                            <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,4" ItemsSource="{Binding ParityOptions}" SelectedItem="{Binding SelectedParity}" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,8,8,8" VerticalAlignment="Center" Text="流控制" />
                            <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,4" ItemsSource="{Binding HandshakeOptions}" SelectedItem="{Binding SelectedHandshake}" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,8,8,8" VerticalAlignment="Center" Text="编码" />
                            <ComboBox Grid.Row="6" Grid.Column="1" Margin="0,4" ItemsSource="{Binding EncodingOptions}" SelectedItem="{Binding SelectedEncoding}" />

                            <StackPanel Grid.Row="7" Grid.ColumnSpan="3" Margin="0,8,0,0" Orientation="Horizontal">
                                <CheckBox Margin="0,0,16,0" Content="DTR 使能" IsChecked="{Binding DtrEnable}" />
                                <CheckBox Margin="0,0,16,0" Content="RTS 使能" IsChecked="{Binding RtsEnable}" />
                                <CheckBox Margin="0,0,16,0" Content="HEX 发送" IsChecked="{Binding SendAsHex}" />
                                <CheckBox Content="HEX 接收" IsChecked="{Binding ReceiveAsHex}" />
                            </StackPanel>

                            <UniformGrid Grid.Row="8" Grid.ColumnSpan="3" Margin="0,16,0,0" Rows="1" Columns="2">
                                <Button Margin="0,0,8,0" Padding="12,8" Command="{Binding ConnectCommand}" Content="连接" />
                                <Button Margin="8,0,0,0" Padding="12,8" Command="{Binding DisconnectCommand}" Content="断开" />
                            </UniformGrid>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="2. 数据发送、记录与回放">
                        <StackPanel Margin="12">
                            <TextBlock Text="发送区支持 ASCII/UTF-8 与 HEX 两种模式。" />
                            <TextBox Margin="0,8,0,8"
                                     AcceptsReturn="True"
                                     Height="100"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding SendText, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Padding="12,8" Command="{Binding SendCommand}" Content="发送数据" />

                            <Separator Margin="0,12" />
                            <CheckBox Margin="0,0,0,8" Content="开启自动保存（每分钟保存一次）" IsChecked="{Binding AutoSaveEnabled}" />
                            <TextBox Margin="0,0,0,8" Text="{Binding AutoSaveFolder, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Margin="0,0,0,8" Padding="12,8" Command="{Binding SaveNowCommand}" Content="手动保存到文件" />
                            <CheckBox Margin="0,0,0,8" Content="回放时保持原始时间间隔" IsChecked="{Binding KeepReplayInterval}" />
                            <Button Padding="12,8" Command="{Binding LoadAndReplayCommand}" Content="载入文件并回放" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <TabControl Grid.Column="2">
                <TabItem Header="数据收发">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="180" />
                        </Grid.RowDefinitions>
                        <ListBox ItemsSource="{Binding CommunicationLog}" />
                        <TextBox Grid.Row="1"
                                 Margin="0,12,0,0"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding ReceiveText}" />
                    </Grid>
                </TabItem>

                <TabItem Header="协议解析">
                    <Grid Margin="12">
                        <DataGrid AutoGenerateColumns="False" ItemsSource="{Binding ParsedPackets}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat=HH:mm:ss.fff}" Width="140" />
                                <DataGridTextColumn Header="命令字" Binding="{Binding CommandHex}" Width="90" />
                                <DataGridTextColumn Header="长度" Binding="{Binding Length}" Width="70" />
                                <DataGridTextColumn Header="校验" Binding="{Binding IsValid}" Width="70" />
                                <DataGridTextColumn Header="数值" Binding="{Binding NumericValue}" Width="100" />
                                <DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="数据可视化">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="220" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Padding="12" BorderBrush="#D7DFEA" BorderThickness="1" CornerRadius="8">
                            <Canvas Width="520" Height="180" Background="#F9FBFD">
                                <Polyline Stroke="#2563EB"
                                          StrokeThickness="2.5"
                                          Points="{Binding VisualizationPoints, Converter={StaticResource DataPointsToPointCollectionConverter}}" />
                            </Canvas>
                        </Border>

                        <UniformGrid Grid.Row="1" Margin="0,12,0,12" Rows="1" Columns="3">
                            <Border Margin="0,0,8,0" Padding="12" Background="#EFF6FF" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="最新值" />
                                    <TextBlock FontSize="24" Text="{Binding LatestValue}" />
                                </StackPanel>
                            </Border>
                            <Border Margin="8,0" Padding="12" Background="#F0FDF4" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="最大值" />
                                    <TextBlock FontSize="24" Text="{Binding MaxValue}" />
                                </StackPanel>
                            </Border>
                            <Border Margin="8,0,0,0" Padding="12" Background="#FEF2F2" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="最小值" />
                                    <TextBlock FontSize="24" Text="{Binding MinValue}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <DataGrid Grid.Row="2" AutoGenerateColumns="False" ItemsSource="{Binding VisualizationPoints}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat=HH:mm:ss.fff}" Width="180" />
                                <DataGridTextColumn Header="数值" Binding="{Binding Value}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontWeight="SemiBold" Text="运行状态：" />
            <TextBlock VerticalAlignment="Center" Text="{Binding StatusMessage}" />
            <Button DockPanel.Dock="Right" Padding="12,8" Command="{Binding ClearCommand}" Content="清空显示" />
        </DockPanel>
    </Grid>
</Window>
